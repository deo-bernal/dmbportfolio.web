# Vercel frontend + cached /api proxy to Azure API
REACT_APP_DEPLOY_PLATFORM=vercel
REACT_APP_DMB_API_TARGET=deployment
REACT_APP_DMB_API_LOCAL_URL=http://localhost:5080/api
REACT_APP_DMB_API_DEPLOY_URL=https://dmbportfolio-api.onrender.com/api
REACT_APP_PRODUCTION_HOSTS=dmbwebsolutions.com,www.dmbwebsolutions.com

# Used by Vercel serverless functions in /api (Render is live; Azure used when deployed)
DMB_API_UPSTREAM_URL=https://dmbportfolio-api.onrender.com/api

# AI profile builder — free options (set in Vercel → Environment Variables):
#
# Groq (recommended, no credit card): https://console.groq.com
#   OPENAI_API_KEY=gsk_...
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=llama-3.3-70b-versatile
#
# OpenRouter (many free models): https://openrouter.ai
#   OPENAI_API_KEY=sk-or-...
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# Paid OpenAI:
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
