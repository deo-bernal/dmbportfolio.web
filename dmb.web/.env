# Vercel frontend + cached /api proxy to Azure API
REACT_APP_DEPLOY_PLATFORM=vercel
REACT_APP_DMB_API_TARGET=deployment
REACT_APP_DMB_API_LOCAL_URL=http://localhost:5080/api
REACT_APP_DMB_API_DEPLOY_URL=https://dmbportfolio-api.onrender.com/api
REACT_APP_PRODUCTION_HOSTS=dmbwebsolutions.com,www.dmbwebsolutions.com

# Used by Vercel serverless functions in /api (Render is live; Azure used when deployed)
DMB_API_UPSTREAM_URL=https://dmbportfolio-api.onrender.com/api

# Required for /api/ai/generate-profile (set in Vercel → Project Settings → Environment Variables)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
