    "test:e2e:oneshot": "powershell -ExecutionPolicy Bypass -File \"../../scripts/run-e2e-one-shot.ps1\"",
    "test:e2e:debug": "powershell -ExecutionPolicy Bypass -File \"../../scripts/run-e2e-keep-alive.ps1\"",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
