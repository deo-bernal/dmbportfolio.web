{
  "name": "DMB Lead Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dmb-lead",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "b1a1b0e0-0001-4000-8000-000000000001",
      "name": "Lead webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-460, 0],
      "webhookId": "dmb-lead"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "version": 2 },
          "conditions": [
            {
              "id": "token-check",
              "operator": { "type": "string", "operation": "equals" },
              "leftValue": "={{ $json.headers['x-dmb-token'] }}",
              "rightValue": "={{ $env.N8N_WEBHOOK_TOKEN }}"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1a1b0e0-0001-4000-8000-000000000002",
      "name": "Shared token valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-240, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "f1", "name": "name", "value": "={{ $json.body.name }}", "type": "string" },
            { "id": "f2", "name": "email", "value": "={{ $json.body.email }}", "type": "string" },
            { "id": "f3", "name": "company", "value": "={{ $json.body.company || '' }}", "type": "string" },
            { "id": "f4", "name": "need", "value": "={{ $json.body.need || 'AI automation' }}", "type": "string" },
            { "id": "f5", "name": "timeline", "value": "={{ $json.body.timeline || 'not stated' }}", "type": "string" },
            { "id": "f6", "name": "message", "value": "={{ $json.body.message || '' }}", "type": "string" },
            { "id": "f7", "name": "source", "value": "={{ $json.body.source || 'funnel-form' }}", "type": "string" },
            { "id": "f8", "name": "bookingUrl", "value": "={{ $json.body.bookingUrl }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "b1a1b0e0-0001-4000-8000-000000000003",
      "name": "Lead fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-20, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: `:zap: New lead from ${$json.source}\n*${$json.name}* <${$json.email}>\nNeeds: ${$json.need}\nTimeline: ${$json.timeline}\n${$json.message}` }) }}",
        "options": {}
      },
      "id": "b1a1b0e0-0001-4000-8000-000000000004",
      "name": "Notify Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, -100]
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "days"
      },
      "id": "b1a1b0e0-0001-4000-8000-000000000005",
      "name": "Wait 2 days",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [420, -100],
      "webhookId": "dmb-lead-wait-1"
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/leads?select=status&order=created_at.desc&limit=1&email=eq.{{ encodeURIComponent($('Lead fields').item.json.email) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "b1a1b0e0-0001-4000-8000-000000000006",
      "name": "Check stage (day 2)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, -100]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "version": 2 },
          "conditions": [
            {
              "id": "stage-new",
              "operator": { "type": "string", "operation": "equals" },
              "leftValue": "={{ $json.status }}",
              "rightValue": "new"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1a1b0e0-0001-4000-8000-000000000007",
      "name": "Still untouched?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [860, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.RESEND_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: $env.LEADS_FROM_EMAIL, to: [$('Lead fields').item.json.email], subject: 'A quick example of what I would build for you', html: `<p>Hi ${$('Lead fields').item.json.name.split(' ')[0]},</p><p>Following up on your note about <strong>${$('Lead fields').item.json.need}</strong>. The write-up at <a href=\"https://www.dmbwebsolutions.com/case-studies/dmb-assistant\">dmbwebsolutions.com/case-studies</a> shows the same pieces working end to end, including the incidents I had to fix after launch.</p><p>If it looks close to what you need, grab a slot: <a href=\"${$('Lead fields').item.json.bookingUrl}\">${$('Lead fields').item.json.bookingUrl}</a></p><p>— Deo</p>` }) }}",
        "options": {}
      },
      "id": "b1a1b0e0-0001-4000-8000-000000000008",
      "name": "Nurture email 1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, -180]
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "days"
      },
      "id": "b1a1b0e0-0001-4000-8000-000000000009",
      "name": "Wait 3 more days",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1300, -180],
      "webhookId": "dmb-lead-wait-2"
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/leads?select=status&order=created_at.desc&limit=1&email=eq.{{ encodeURIComponent($('Lead fields').item.json.email) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "b1a1b0e0-0001-4000-8000-000000000010",
      "name": "Check stage (day 5)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1520, -180]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "version": 2 },
          "conditions": [
            {
              "id": "stage-still-new",
              "operator": { "type": "string", "operation": "equals" },
              "leftValue": "={{ $json.status }}",
              "rightValue": "new"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1a1b0e0-0001-4000-8000-000000000011",
      "name": "Still untouched? (day 5)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1740, -180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.RESEND_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: $env.LEADS_FROM_EMAIL, to: [$('Lead fields').item.json.email], subject: 'Closing the loop', html: `<p>Hi ${$('Lead fields').item.json.name.split(' ')[0]},</p><p>Last note from me so your inbox gets a rest. If the timing is wrong, no problem — reply whenever it changes and I will pick it straight up.</p><p>The calendar stays open here: <a href=\"${$('Lead fields').item.json.bookingUrl}\">${$('Lead fields').item.json.bookingUrl}</a></p><p>— Deo</p>` }) }}",
        "options": {}
      },
      "id": "b1a1b0e0-0001-4000-8000-000000000012",
      "name": "Nurture email 2",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1960, -260]
    }
  ],
  "connections": {
    "Lead webhook": {
      "main": [[{ "node": "Shared token valid?", "type": "main", "index": 0 }]]
    },
    "Shared token valid?": {
      "main": [[{ "node": "Lead fields", "type": "main", "index": 0 }], []]
    },
    "Lead fields": {
      "main": [[{ "node": "Notify Slack", "type": "main", "index": 0 }]]
    },
    "Notify Slack": {
      "main": [[{ "node": "Wait 2 days", "type": "main", "index": 0 }]]
    },
    "Wait 2 days": {
      "main": [[{ "node": "Check stage (day 2)", "type": "main", "index": 0 }]]
    },
    "Check stage (day 2)": {
      "main": [[{ "node": "Still untouched?", "type": "main", "index": 0 }]]
    },
    "Still untouched?": {
      "main": [[{ "node": "Nurture email 1", "type": "main", "index": 0 }], []]
    },
    "Nurture email 1": {
      "main": [[{ "node": "Wait 3 more days", "type": "main", "index": 0 }]]
    },
    "Wait 3 more days": {
      "main": [[{ "node": "Check stage (day 5)", "type": "main", "index": 0 }]]
    },
    "Check stage (day 5)": {
      "main": [[{ "node": "Still untouched? (day 5)", "type": "main", "index": 0 }]]
    },
    "Still untouched? (day 5)": {
      "main": [[{ "node": "Nurture email 2", "type": "main", "index": 0 }], []]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [{ "name": "dmb" }, { "name": "leads" }]
}
