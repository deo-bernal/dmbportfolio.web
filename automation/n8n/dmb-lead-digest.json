{
  "name": "DMB Lead Digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [1],
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "c2b2c1f1-0002-4000-8000-000000000001",
      "name": "Monday 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-300, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/leads?select=name,email,need,timeline,status,created_at&order=created_at.desc&created_at=gte.{{ new Date(Date.now() - 7*24*60*60*1000).toISOString() }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "options": { "response": { "response": { "responseFormat": "json" } } }
      },
      "id": "c2b2c1f1-0002-4000-8000-000000000002",
      "name": "Last 7 days of leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-80, 0]
    },
    {
      "parameters": {
        "jsCode": "const leads = items.map((item) => item.json);\nconst byStatus = leads.reduce((acc, lead) => {\n  const key = lead.status || 'new';\n  acc[key] = (acc[key] || 0) + 1;\n  return acc;\n}, {});\n\nconst lines = leads\n  .slice(0, 15)\n  .map((lead) => `• *${lead.name}* <${lead.email}> — ${lead.need || 'unspecified'} (${lead.status || 'new'})`);\n\nconst summary = Object.entries(byStatus)\n  .map(([status, count]) => `${count} ${status}`)\n  .join(', ') || 'no leads';\n\nreturn [{ json: { text: `:bar_chart: *Weekly lead digest* — ${leads.length} lead(s): ${summary}\\n${lines.join('\\n')}` } }];"
      },
      "id": "c2b2c1f1-0002-4000-8000-000000000003",
      "name": "Build summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [140, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text }) }}",
        "options": {}
      },
      "id": "c2b2c1f1-0002-4000-8000-000000000004",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [360, 0]
    }
  ],
  "connections": {
    "Monday 08:00": {
      "main": [[{ "node": "Last 7 days of leads", "type": "main", "index": 0 }]]
    },
    "Last 7 days of leads": {
      "main": [[{ "node": "Build summary", "type": "main", "index": 0 }]]
    },
    "Build summary": {
      "main": [[{ "node": "Post to Slack", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [{ "name": "dmb" }, { "name": "leads" }]
}
